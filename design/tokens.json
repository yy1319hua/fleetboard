{
  "version": 2,
  "$comment": "fleetboard 设计令牌唯一真源。两端由 scripts/gen_design_tokens.py 生成，CI 用 --check 校验。禁止手工改生成物。值的语义说明见 web/DESIGN.md。v2 = 深色层次优化：表面/边框提亮、新增 border-hi 顶边线、派生色入真源、补 surface-3 对比度断言。",
  "colors": {
    "bg": "#0E1116",
    "surface-1": "#1A1F28",
    "surface-2": "#222935",
    "surface-3": "#2C3442",
    "border": "#3A4453",
    "border-strong": "#4E5A6C",
    "border-hi": "#4A5666",
    "terminal": "#0B0D10",
    "text": "#EDF0F5",
    "text-muted": "#A6B0BE",
    "text-faint": "#919CAC",
    "text-inverse": "#0E1116",
    "accent": "#E8A33D",
    "accent-hover": "#F0B45A",
    "accent-soft": [232, 163, 61, 0.14],
    "ok": "#3FB950",
    "warn": "#D29922",
    "danger": "#F85149",
    "info": "#58A6FF",
    "idle": "#8B949E"
  },
  "derived": {
    "$comment": "派生色：图表 / 遮罩 / 强调底。value 直给不随色板变；from 取色板某色；format = rgb | rgba | hex；alpha 仅 rgba 用。生成器不再内置派生规则。",
    "chart-accent": {"from": "accent", "format": "rgb"},
    "chart-info": {"from": "info", "format": "hex"},
    "chart-ok": {"from": "ok", "format": "hex"},
    "chart-grid": {"value": "#333C49"},
    "chart-axis": {"from": "text-faint", "format": "hex"},
    "chart-tick": {"from": "text-muted", "format": "hex"},
    "chart-tooltip-bg": {"from": "surface-2", "format": "hex"},
    "chart-tooltip-border": {"from": "border-strong", "format": "hex"},
    "scrim": {"from": "terminal", "format": "rgba", "alpha": 0.6},
    "scrim-strong": {"from": "terminal", "format": "rgba", "alpha": 0.7},
    "accent-wash-06": {"from": "accent", "format": "rgba", "alpha": 0.06},
    "accent-wash-10": {"from": "accent", "format": "rgba", "alpha": 0.1},
    "accent-wash-20": {"from": "accent", "format": "rgba", "alpha": 0.2}
  },
  "fonts": {
    "$comment": "family 名必须是实际注册的：Web 由 @fontsource-variable/geist 与 jetbrains-mono 注册为 'Geist Variable' / 'JetBrains Mono Variable'（DESIGN.md 里的 'Geist Sans' / 'JetBrains Mono' 是概念名）。Web 已打包字体；App 未打包，仅声明优先名 + 回退链，属有意的偏差。",
    "ui": "Geist Variable",
    "mono": "JetBrains Mono Variable",
    "ui_fallback": ["-apple-system", "Segoe UI", "Noto Sans SC", "sans-serif"],
    "mono_fallback": ["Menlo", "Consolas", "monospace"]
  },
  "type_scale": {
    "display": {"size": 30, "line_height": 1.2, "weight": 600},
    "h1": {"size": 22, "line_height": 1.3, "weight": 600},
    "h2": {"size": 18, "line_height": 1.35, "weight": 600},
    "h3": {"size": 15, "line_height": 1.4, "weight": 600},
    "body": {"size": 14, "line_height": 1.5, "weight": 400},
    "body-sm": {"size": 13, "line_height": 1.5, "weight": 400},
    "caption": {"size": 12, "line_height": 1.4, "weight": 500},
    "eyebrow": {"size": 11, "line_height": 1.4, "weight": 600, "letter_spacing": 0.06},
    "mono": {"size": 13, "line_height": 1.6, "weight": 400},
    "mono-sm": {"size": 12, "line_height": 1.6, "weight": 400}
  },
  "spacing": {"unit": 4, "xs": 4, "sm": 8, "md": 12, "lg": 16, "xl": 24, "xxl": 32},
  "radius": {"badge": 4, "sm": 6, "md": 8, "lg": 12, "pill": 999},
  "motion": {"short_ms": 120, "medium_ms": 200, "web_ui_ms": 160},
  "touch_min": 44,
  "contrast_pairs": [
    ["text", "bg"],
    ["text", "surface-1"],
    ["text", "surface-3"],
    ["text-muted", "bg"],
    ["text-muted", "surface-1"],
    ["text-muted", "surface-3"],
    ["text-faint", "bg"],
    ["text-faint", "surface-1"],
    ["text-faint", "surface-2"],
    ["text-faint", "surface-3"],
    ["accent", "bg"],
    ["accent", "surface-1"],
    ["text-inverse", "accent"],
    ["ok", "surface-1"],
    ["warn", "surface-1"],
    ["danger", "surface-1"],
    ["info", "surface-1"],
    ["idle", "surface-1"]
  ]
}
