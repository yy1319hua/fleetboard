# fleetboard 运行配置（install.sh 会拷到 /opt/fleetboard/.env，600 权限）
# ⚠️ 本文件入库的是占位模板，真实值绝不提交到任何仓库。

# 密钥类（必填）。生成方式：openssl rand -hex 32
KEY=            # 凭据加密主密钥（AES-256-GCM），丢了已存凭据无法解密
# JWT_SECRET 已入库 settings 表（首启自动生成或吸收 env 原值），不再写入 .env
# 管理员账密（M8.1a 自举）：首启 users 空时，BOOTSTRAP_* 环境变量齐全则用之，
# 否则自动生成随机账密打印到日志（仅一次）。服务起来后可从设置面改密。
# BOOTSTRAP_USER=
# BOOTSTRAP_PASS=

# 网络与路径
# 二进制部署经 cloudflared 对接：保持 127.0.0.1（公网仅经 Tunnel 暴露）
LISTEN_ADDR=127.0.0.1
PORT=8080
DATA_DIR=/var/lib/fleetboard
WEB_DIR=/opt/fleetboard/web-dist

# 可选
MONITOR_INTERVAL=30
METRICS_RETENTION_DAYS=30
OFFLINE_THRESHOLD=2
PUSHPLUS_TOKEN=

# 面板自我升级（默认关闭）。开启后 App 可触发「下载→校验→停服→换文件→健康检查→回滚」全流程，
# 依赖：systemd（需 systemd-run，且 unit 需允许本服务调用它）、/opt/fleetboard 与 /var/lib/fleetboard
# 可写。只在 systemd 部署（非容器）且你有回滚兜底时才打开。
# FLEETBOARD_UPGRADE_ENABLED=1
