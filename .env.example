# fleetboard 环境变量示例
# 复制为 .env 后填写；.env 不得入库。
# 生产环境建议通过容器/系统环境变量注入，而非 .env 文件。

# ---- 服务监听 ----
# 默认只监听回环，公网访问经 Cloudflare Tunnel 接入
LISTEN_ADDR=127.0.0.1
PORT=8080

# ---- 数据目录 ----
DATA_DIR=./data
# DB_PATH=./data/fleetboard.db

# ---- 必填密钥（生成示例：openssl rand -base64 32）----
# KEY：凭据（SSH 私钥/口令）加密主密钥，AES-256-GCM
KEY=
# JWT_SECRET：登录令牌签名密钥
JWT_SECRET=

# ---- 首次启动管理员（仅 users 表为空时创建）----
BOOTSTRAP_USER=admin
BOOTSTRAP_PASS=

# ---- 监控 ----
MONITOR_INTERVAL=30
METRICS_RETENTION_DAYS=30
# 连续失败多少次判定离线（30s 采集间隔下 2 次 ≈ 60s 内标红）
OFFLINE_THRESHOLD=2

# ---- 告警（可选）----
PUSHPLUS_TOKEN=

# ---- Compose 管理 ----
# compose 文件可读写的根目录白名单，逗号分隔；留空用内置默认
# 内置默认：/root,/opt,/srv,/home,/etc,/usr/local
# COMPOSE_ROOTS=/opt/stacks,/srv/apps
